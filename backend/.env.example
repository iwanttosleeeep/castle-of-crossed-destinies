# DeepSeek OpenAI-compatible API. Keep this file private and never commit the real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# BYOK never falls back to the server key. Hosted AI needs explicit funding.
# Cumulative lifetime USD ceilings, NOT monthly allowances.
CASTLE_FREE_BUDGET_USD=0
CASTLE_PAID_BUDGET_USD=0
CASTLE_PROVIDER_CONCURRENCY=3

# Peak USD / million tokens: verify rates before funding budgets.
CASTLE_FLASH_INPUT_RATE=0.30
CASTLE_FLASH_CACHED_RATE=0.006
CASTLE_FLASH_OUTPUT_RATE=1.20
CASTLE_PRO_INPUT_RATE=1.32
CASTLE_PRO_CACHED_RATE=0.044
CASTLE_PRO_OUTPUT_RATE=3.96

# disabled or test. Live collection is not enabled by this release.
CASTLE_PAYMENT_MODE=disabled
CASTLE_PUBLIC_URL=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DOSSIER=
STRIPE_PRICE_HEARING=
